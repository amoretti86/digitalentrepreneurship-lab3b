# Copy this file to .env (in the repo root, next to package.json) and fill in your own values.
# NEVER commit .env to GitHub - the secret key gives full admin access to your Supabase project.

# Supabase dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Secret keys (starts with sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Port the Express server listens on locally (Heroku sets this for you - don't set it there)
PORT=5001
